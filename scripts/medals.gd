class_name Medals
extends RefCounted
## Medal targets per car per track (SPEC 39): every car gets its own ladder to climb, so a fast lap in the
## Kart is worth as much as one in the Formula. The targets are the hard AI's best lap in that car on
## that track (MedalTimes, generated by tools/measure_laps.gd):
##   GOLD    -- beat the best AI
##   SILVER  -- within 6 % of it
##   BRONZE  -- within 15 % of it
## Pure data + static lookups (no GameState): usable from `--script` test runs.

const NONE := 0
const BRONZE := 1
const SILVER := 2
const GOLD := 3

## Share of the AI's best lap each medal allows, BRONZE / SILVER / GOLD.
const FACTORS := [1.15, 1.06, 1.0]
const NAMES := ["", "BRONZE", "SILVER", "GOLD"]
const COLORS := [Color(0.5, 0.5, 0.5), Color(0.80, 0.50, 0.25), Color(0.80, 0.83, 0.88), Color(1.0, 0.80, 0.22)]


## The AI's best lap for `car_id` on `track_id` (INF when not measured).
static func ai_best_lap(track_id: String, car_id: String) -> float:
	var t: Dictionary = MedalTimes.AI_BEST_LAP.get(track_id, {})
	return float(t.get(CarRegistry.resolve(car_id), INF))


## The lap time needed for `medal` (BRONZE / SILVER / GOLD).
static func target(track_id: String, car_id: String, medal: int) -> float:
	if medal < BRONZE or medal > GOLD:
		return INF
	return ai_best_lap(track_id, car_id) * float(FACTORS[medal - 1])


## The medal a best lap of `lap` s earns.
static func medal_for(track_id: String, car_id: String, lap: float) -> int:
	if not is_finite(lap) or lap <= 0.0:
		return NONE
	for m in [GOLD, SILVER, BRONZE]:
		if lap <= target(track_id, car_id, m) + 0.0005:
			return m
	return NONE


static func medal_name(medal: int) -> String:
	return NAMES[clampi(medal, 0, GOLD)]


static func medal_color(medal: int) -> Color:
	return COLORS[clampi(medal, 0, GOLD)]


## The cars in order of their AI best lap on `track_id`, fastest first.
static func cars_by_pace(track_id: String) -> PackedStringArray:
	var t: Dictionary = MedalTimes.AI_BEST_LAP.get(track_id, {})
	var ids: Array = []
	for c in CarRegistry.ids():
		if t.has(c):
			ids.append(c)
	ids.sort_custom(func(a, b): return float(t[a]) < float(t[b]))
	return PackedStringArray(ids)


## The `count` tracks where `car_id` is closest to the fastest car (fastest of all first) -- its best
## tracks, for the car screen.
static func best_tracks(car_id: String, count: int = 2) -> PackedStringArray:
	var cid := CarRegistry.resolve(car_id)
	var gaps: Array = []
	for tid in TrackRegistry.ids():
		var order := cars_by_pace(tid)
		if order.is_empty():
			continue
		gaps.append([ai_best_lap(tid, cid) / ai_best_lap(tid, order[0]), tid])
	gaps.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
	var out := PackedStringArray()
	for i in mini(count, gaps.size()):
		out.append(String(gaps[i][1]))
	return out

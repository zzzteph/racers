extends SceneTree
## Bakes CHANGELOG.md into `scripts/release_notes_data.gd` (SPEC 113), so the release notes ship inside
## every export as a script constant. A markdown file is not a resource: the export's `include_filter`
## never picked it up (a headless export tracks no text files), and a build whose WHAT'S NEW says "the
## notes did not ship" is worse than none. The suite fails when the baked copy is stale, and
## deploy/release.sh runs this before it exports.
##   godot --headless --path . --script res://tools/bake_release_notes.gd

const SOURCE := "res://CHANGELOG.md"
const TARGET := "res://scripts/release_notes_data.gd"


func _init() -> void:
	var f := FileAccess.open(SOURCE, FileAccess.READ)
	if f == null:
		print("bake_release_notes: cannot read %s" % SOURCE)
		quit(1)
		return
	var text := f.get_as_text()
	f.close()
	var out := FileAccess.open(TARGET, FileAccess.WRITE)
	if out == null:
		print("bake_release_notes: cannot write %s" % TARGET)
		quit(1)
		return
	out.store_string(bake(text))
	out.close()
	print("wrote %s (%d bytes of notes)" % [TARGET, text.length()])
	quit(0)


## The script's source: one escaped string constant.
static func bake(text: String) -> String:
	var escaped := text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", "").replace("\n", "\\n")
	return ("class_name ReleaseNotesData\nextends RefCounted\n"
			+ "## GENERATED by tools/bake_release_notes.gd from CHANGELOG.md -- do not edit by hand (SPEC 113).\n"
			+ "## The release notes, as they ship inside every export; the suite fails when this is stale.\n\n"
			+ "const TEXT := \"" + escaped + "\"\n")
